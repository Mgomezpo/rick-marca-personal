# ==============================================================================
# RICK Multi-Tenant Engine — Environment Variables Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit .env to source control.
# ==============================================================================

# --- Database & Persistence (Supabase Multi-Tenant) ---
SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY takes precedence; SUPABASE_KEY is supported as fallback
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# --- LLM Providers & Model Orchestration ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
ORCHESTRATOR_MODEL=gpt-4o
WRITER_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- WhatsApp Cloud API (Meta Graph v19+) ---
WHATSAPP_TOKEN=your_whatsapp_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=rick_secret_verify_token_2026

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Market Radar & Data Ingestion (Apify / RapidAPI) ---
APIFY_API_TOKEN=your_apify_api_token_here
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com

# --- Application Runtime & Environment ---
APP_ENV=development
PORT=8000
DEBUG=false
