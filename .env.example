# =============================================================================
# RICK Multitenant — Variables de Entorno de Producción y Desarrollo
# =============================================================================

# --- Servidor ---
APP_ENV=production
PORT=8000
DEBUG=False

# --- Supabase (Multitenancy, Auth y Postgres) ---
SUPABASE_URL=https://<TU_PROYECTO>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# --- Modelos de Inteligencia Artificial ---
# OpenAI (Motor principal conversacional y Function Calling)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Google Gemini (Herramientas multimodales, embeddings y grounding)
GEMINI_API_KEY=AIza...
ORCHESTRATOR_MODEL=gpt-4o
WRITER_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-004

# --- Canales de Comunicación ---
# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=cambia_este_token_secreto_para_meta_webhook
WHATSAPP_API_VERSION=v20.0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# --- Scraping & Servicios Auxiliares (Opcionales) ---
# Apify (Scraping de perfiles y reels de Instagram)
APIFY_API_TOKEN=apify_api_...

# RapidAPI (Fallback Instagram Scraper)
RAPIDAPI_KEY=...
RAPIDAPI_HOST=instagram-scraper-stable-api.p.rapidapi.com
